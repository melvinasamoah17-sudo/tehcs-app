rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Chat images — users upload to their own UID folder; all signed-in users can read
    // (staff need to read images customers send in chat)
    match /chat_images/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Staff/admin (same definition as isStaff() in firestore.rules).
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == 'twitchempireinfo@gmail.com' ||
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid)));
    }

    // Chat voice notes, one folder per customer thread ({clientUid}).
    // The customer and staff can add notes and delete them (delete message /
    // delete chat / delete account).
    match /chat_audio/{clientUid}/{fileName} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && (request.auth.uid == clientUid || isStaff())
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null
                    && (request.auth.uid == clientUid || isStaff());
    }

    // Catch-all: deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
