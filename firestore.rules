rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is an authorized staff member
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == 'twitchempireinfo@gmail.com' ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staff_by_email/$(request.auth.token.email))
      );
    }

    // 1. Enquiries (from tehcs.com contact form)
    match /enquiries/{docId} {
      allow create: if true; // Public can submit
      allow read, update, delete: if isStaff();
    }

    // 2. Services (App/Website list)
    match /services/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 3. Staff Accounts
    // Only existing staff (or the hardcoded owner) may create/modify staff records.
    // Self-write is intentionally NOT allowed, to prevent privilege escalation.
    match /staff/{userId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // 3b. Staff lookup by email (used for role resolution and by the
    // isStaff() helper). Any signed-in user needs to read this to
    // check their own role; only staff/admin can add or remove entries.
    match /staff_by_email/{email} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // 4. Bookings
    match /bookings/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isStaff() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
      allow delete: if isStaff();
    }

    // 5. Clients (App Profiles)
    match /clients/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isStaff() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid || docId == request.auth.uid));
      // Customers can delete their own profile (in-app account deletion)
      allow delete: if isStaff() || (request.auth != null && (resource.data.uid == request.auth.uid || docId == request.auth.uid));
    }

    // 5a. Phone push tokens (each user writes only their own)
    match /device_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 5b. Admin notifications (staff accept a job / clock in)
    match /notifications/{docId} {
      allow create: if isStaff();
      allow read, update, delete: if request.auth != null &&
        request.auth.token.email == 'twitchempireinfo@gmail.com';
    }

    // 5c. Identity verification log (written by the user after VerifyAfrica)
    match /verifications/{docId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isStaff();
    }

    // 6. Chats (Support messages)
    match /chats/{docId} {
      allow create: if request.auth != null;
      // Fixed: removed resource == null on reads so users can't read other people's chats
      allow read, update: if isStaff() || (request.auth != null && resource != null && resource.data.uid == request.auth.uid);
      allow delete: if isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
